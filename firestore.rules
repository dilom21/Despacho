rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'admin@despacho.com';
    }

    match /telemetria/{uid} {
      // Cliente, conductor y administrador necesitan ver la flota en el mapa.
      allow read: if request.auth != null;

      // Los perfiles de conductor no se crean desde una ruta pública.
      // Se aprovisionan previamente y solo el administrador puede crear el registro.
      allow create: if isAdmin();

      // El conductor actualiza su GPS, pero no puede quitarse un bloqueo.
      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.bloqueado == resource.data.bloqueado
      );

      allow delete: if isAdmin();
    }

    match /viajes/{viajeId} {
      // El cliente anónimo crea un viaje identificado con su UID.
      allow create: if request.auth != null &&
                    request.resource.data.cliente_uid == request.auth.uid;

      // Solo cliente dueño, conductor asignado y admin pueden leer el viaje.
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.cliente_uid == request.auth.uid ||
        resource.data.conductor_asignado == request.auth.uid
      );

      // El conductor asignado puede cambiar el estado del viaje.
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.conductor_asignado == request.auth.uid &&
        request.resource.data.conductor_asignado == request.auth.uid &&
        request.resource.data.cliente_uid == resource.data.cliente_uid
      );

      allow delete: if isAdmin();
    }

    match /auditorias_desvios/{auditoriaId} {
      allow read: if isAdmin();

      // El conductor puede registrar su propia falla; el admin registra desvíos.
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.conductor_id == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }
  }
}
